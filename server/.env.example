# Copy to server/.env (git-ignored) or set these in the host's environment.
PORT=4000

# Required for the tracker API: a random secret of at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
HR_JWT_SECRET=
HR_JWT_TTL=8h

# Browser origins allowed to call the API (comma-separated).
HR_ALLOWED_ORIGINS=https://rituchopra07.github.io,http://127.0.0.1:8080

# Storage: "file" (server/data/trackers, for development) or "mssql" (shared database).
HR_TRACKER_STORE=file
# HR_DB_SERVER=
# HR_DB_NAME=HRPortalDB
# HR_DB_USER=hrportal_app
# HR_DB_PASSWORD=
# HR_DB_ENCRYPT=true
# HR_DB_TRUST_CERT=false
